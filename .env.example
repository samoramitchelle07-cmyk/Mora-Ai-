PORT=3000
GEMINI_API_KEY=put_your_gemini_key_here
E2B_API_KEY=put_your_e2b_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional Playwright HTML smoke test; install browser with: npx playwright install chromium
NODE_ENV=development
# Optional locally. REQUIRED for production deployments exposed to the internet.
MORA_API_TOKEN=
# Optional comma-separated exact origins, e.g. https://your-site.example
CORS_ORIGIN=
MAX_REQUESTS_PER_MINUTE=20
